<!DOCTYPE html><html lang="bn"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><title>কালোজিরা ফুলের মধু — হাদিয়া শপ</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Tiro+Bangla&display=swap" rel="stylesheet">
<style>
:root{--ol:#2f3d17;--gr:#4f7a2a;--gold:#d99a1e;--cream:#f6efdc;--off:#fcfaf4;--br:#6b4a2b;--ink:#26301a;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme=light]){--off:#fcfaf4}}
*{box-sizing:border-box;margin:0}html{scroll-behavior:smooth;scroll-padding-top:72px}
body{font:400 16px/1.7 'Hind Siliguri',sans-serif;background:var(--off);color:var(--ink);overflow-x:hidden}
h1,h2,h3,.d{font-family:'Tiro Bangla','Hind Siliguri',serif;font-weight:400;line-height:1.35;color:var(--ol)}
h2{font-size:clamp(26px,4.4vw,40px);text-align:center;margin-bottom:12px}
img{max-width:100%;display:block}a{color:inherit;text-decoration:none}
.w{max-width:1120px;margin:0 auto;padding:0 20px}.sec{padding:72px 0}.sub{text-align:center;max-width:620px;margin:0 auto 36px;color:#55603f}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:50px;padding:0 26px;border-radius:999px;font:600 17px 'Hind Siliguri';border:2px solid var(--gold);background:var(--gold);color:#2a1d05;cursor:pointer;transition:transform .2s,box-shadow .2s}
.btn:hover{transform:translateY(-2px);box-shadow:0 8px 20px #d99a1e55}.btn.o{background:transparent;color:var(--ol);border-color:var(--ol)}.btn.wa{background:#1f9d55;border-color:#1f9d55;color:#fff}.dk .btn.o{color:#fff;border-color:#fff8}
header{position:sticky;top:0;z-index:50;background:#fcfaf4ee;backdrop-filter:blur(8px);transition:box-shadow .3s}header.s{box-shadow:0 2px 16px #0002}
.hb{display:flex;align-items:center;justify-content:space-between;height:64px}.hb img{height:48px;width:48px;object-fit:contain}
nav{display:flex;gap:22px;align-items:center;font-weight:500}nav a:hover{color:var(--gr)}nav .btn{min-height:42px;padding:0 20px;font-size:16px}
#bg{display:none;background:none;border:0;font-size:28px;color:var(--ol);min-width:44px;min-height:44px}
.hero{background:radial-gradient(ellipse at 70% 40%,#f3d58a 0,#f6efdc 45%,#fcfaf4 80%);position:relative;overflow:hidden;padding:48px 0 64px}
.hg{display:grid;grid-template-columns:1.1fr 1fr;gap:40px;align-items:center}
.hero h1{font-size:clamp(34px,6vw,60px);margin-bottom:14px}.em{font-size:clamp(18px,2.6vw,24px);color:var(--br);font-weight:600;margin-bottom:12px}
.hero p{max-width:520px;margin-bottom:22px}.bt{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:14px}.tl{font-size:14px;color:var(--gr);font-weight:600;margin-top:14px}
.pi{position:relative;display:flex;justify-content:center}.pi:before{content:"";position:absolute;inset:8% 6%;background:radial-gradient(#f2b73a99,transparent 68%);filter:blur(24px);animation:gl 5s ease-in-out infinite alternate}
.pi img{position:relative;max-height:560px;width:auto;border-radius:22px;box-shadow:0 24px 50px #6b4a2b44}
.pt{position:absolute;width:8px;height:8px;border-radius:50%;background:var(--gold);opacity:.5;animation:fl 7s ease-in-out infinite}
@keyframes gl{to{opacity:.55;transform:scale(1.08)}}@keyframes fl{50%{transform:translateY(-22px) translateX(8px)}}
@keyframes up{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:none}}
.hero .t>*{animation:up .8s both}.hero .t>*:nth-child(2){animation-delay:.1s}.hero .t>*:nth-child(3){animation-delay:.2s}.hero .t>*:nth-child(4){animation-delay:.3s}.hero .pi img{animation:up 1.1s .2s both}
.rv{opacity:0;transform:translateY(22px);transition:.7s}.rv.in{opacity:1;transform:none}
.ps{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}.ps .im{border-radius:24px;overflow:hidden;background:var(--cream)}.ps .im img{width:100%;transition:transform .6s}.ps .im:hover img{transform:scale(1.06)}
.ps h2{text-align:left}.inf{margin:18px 0;border-top:1px solid #d9cfb0}.inf div{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid #d9cfb0}.inf b{color:var(--ol)}
.old{text-decoration:line-through;color:#8a7f66}.pr{color:var(--br);font-weight:700;font-size:22px}
.emo{background:linear-gradient(120deg,var(--ol),#4a5e22);color:#fff;position:relative;overflow:hidden}.emo h2,.emo .d{color:#fbe6b0;text-align:left}
.eg{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}.emo .fr{border-radius:200px 200px 24px 24px;overflow:hidden;aspect-ratio:4/5;border:4px solid #d99a1e88}.emo .fr img{width:100%;height:100%;object-fit:cover;object-position:50% 55%;transform:scale(1.5);transform-origin:50% 60%}
.cd4{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.cd{background:#fff;border:1px solid #e6dcc0;border-radius:18px;padding:26px 20px}.cd i{display:block;font:normal 700 15px 'Hind Siliguri';color:var(--gold);margin-bottom:8px}.cd h3{font-size:20px;margin-bottom:6px}.cd p{font-size:15px;color:#55603f}
.st{background:var(--cream)}.sg{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.sp{text-align:center}.sp .ic{aspect-ratio:1;border-radius:50%;background:#fff;border:3px solid #e6d9aa;overflow:hidden;display:grid;place-items:center;margin:0 auto 12px;width:100%;max-width:190px}.sp svg{width:70%}.sp img{width:100%;height:100%;object-fit:cover;object-position:50% 70%;transform:scale(1.9)}.sp b{display:block;color:var(--gold)}
.tg{display:grid;grid-template-columns:repeat(5,1fr);gap:14px}.tc{text-align:center;background:#fff;border:1px solid #e6dcc0;border-radius:16px;padding:22px 10px}.tc span{font-size:34px;display:block}.tc b{color:var(--ol)}
.gl{position:relative;max-width:760px;margin:auto;border-radius:24px;overflow:hidden;aspect-ratio:4/3;background:var(--cream)}.gs{position:absolute;inset:0;opacity:0;transition:opacity .8s;display:grid;place-items:center;overflow:hidden}.gs.on{opacity:1}.gs img{height:100%;width:100%;object-fit:cover}
.dots{position:absolute;bottom:12px;left:0;right:0;display:flex;justify-content:center;gap:8px}.dots button{width:12px;height:12px;border-radius:50%;border:0;background:#fff9;cursor:pointer}.dots .on{background:var(--gold)}
.offer{background:var(--cream)}.oc{max-width:820px;margin:auto;background:#fff;border-radius:28px;padding:32px;display:grid;grid-template-columns:240px 1fr;gap:30px;align-items:center;border:2px solid var(--gold)}.oc img{border-radius:16px}.oc h2{text-align:left;font-size:28px}
form,.cf{max-width:760px;margin:auto;background:#fff;border:1px solid #e6dcc0;border-radius:24px;padding:28px}
fieldset{border:0;padding:0;margin-bottom:18px}legend{font:700 18px 'Tiro Bangla';color:var(--ol);margin-bottom:8px}
.r2{display:grid;grid-template-columns:1fr 1fr;gap:12px}label{display:block;font-size:14px;font-weight:600;margin:8px 0 4px}
input,select,textarea{width:100%;min-height:48px;padding:10px 14px;font:inherit;border:1.5px solid #d6cba8;border-radius:12px;background:var(--off);color:var(--ink)}input:focus,select:focus,textarea:focus{outline:2px solid var(--gold);border-color:var(--gold)}
.q{display:flex;align-items:center;gap:14px}.q button{width:48px;height:48px;border-radius:50%;border:2px solid var(--gold);background:#fff;font-size:24px;cursor:pointer}.q b{min-width:90px;text-align:center;font-size:18px}
.sm{background:var(--cream);border-radius:16px;padding:16px 18px;margin:16px 0}.sm div{display:flex;justify-content:space-between;padding:4px 0}.sm .t2{border-top:2px dashed #cdbf8c;margin-top:6px;padding-top:10px;font-weight:700;font-size:19px;color:var(--ol)}
.cf{text-align:center;animation:up .6s}.cf h3{font-size:26px;margin-bottom:14px}.cf dl{text-align:left;margin:16px 0}.cf dl div{display:flex;justify-content:space-between;gap:12px;padding:7px 0;border-bottom:1px solid #eee3c4}.cf dd{text-align:right;font-weight:600}
.rs{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:10px}.rc{flex:0 0 min(340px,85%);scroll-snap-align:center;background:#fff;border:1px dashed #cdbf8c;border-radius:18px;padding:26px;color:#6f6a55}
details{background:#fff;border:1px solid #e6dcc0;border-radius:14px;margin-bottom:10px;max-width:760px;margin-inline:auto}summary{padding:16px 20px;font-weight:600;cursor:pointer;color:var(--ol);list-style:none;display:flex;justify-content:space-between;gap:10px;min-height:52px;align-items:center}summary:after{content:"+";font-size:24px;color:var(--gold);transition:transform .3s}details[open] summary:after{transform:rotate(45deg)}
.ans{padding:0 20px 16px;color:#55603f;animation:up .4s}
.ol2{max-width:560px;margin:auto;list-style:none;padding:0}.ol2 li{display:flex;align-items:center;gap:12px;padding:8px 0;border-bottom:1px solid #e6dcc0;font-size:15px}.ol2 em{font-style:normal;color:var(--gold);font-weight:700}.ol2 .th{width:34px;height:34px;border-radius:50%;background:var(--cream);display:grid;place-items:center;font-size:17px}.ol2 a{margin-left:auto;color:var(--gr);font-weight:600}
.fin{background:linear-gradient(rgba(35,46,14,.82),rgba(35,46,14,.9)),var(--ol);color:#fff;text-align:center;position:relative;overflow:hidden}.fin h2{color:#fbe6b0}.fin img.bg{position:absolute;right:-6%;top:0;height:100%;width:auto;opacity:.22;object-fit:cover}.fin .w{position:relative}
footer{background:#222b10;color:#d8dcc8;padding:44px 0 90px;font-size:15px}.fg{display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:30px}footer img{height:84px;width:84px;object-fit:contain;background:#fff;border-radius:50%;padding:4px;margin-bottom:10px}footer a{display:block;padding:3px 0}footer a:hover{color:var(--gold)}
.bar{display:none}.fwa{position:fixed;right:18px;bottom:18px;z-index:40;width:58px;height:58px;border-radius:50%;background:#1f9d55;color:#fff;display:grid;place-items:center;font-size:28px;box-shadow:0 8px 20px #0004;animation:gl 2.5s infinite alternate}
@media(max-width:860px){#bg{display:block}nav{position:absolute;top:64px;left:0;right:0;background:var(--off);flex-direction:column;padding:16px 20px 22px;gap:14px;box-shadow:0 12px 18px #0002;display:none}nav.o{display:flex;animation:up .3s}
.hg,.ps,.eg,.oc,.fg{grid-template-columns:1fr}.hero{padding-top:28px}.hero .pi{order:-1}.pi img{max-height:380px}.cd4,.sg{grid-template-columns:1fr 1fr}.tg{grid-template-columns:1fr 1fr}.ps h2,.emo h2,.oc h2{text-align:center}.emo .d{text-align:center}.oc img{max-width:200px;margin:auto}.sec{padding:52px 0}.r2{grid-template-columns:1fr}.fwa{display:none}
.bar{display:grid;grid-template-columns:1fr 1fr;gap:10px;position:fixed;left:0;right:0;bottom:0;z-index:60;padding:10px 14px calc(10px + env(safe-area-inset-bottom,0px));background:#fcfaf4f2;box-shadow:0 -4px 16px #0002}.bar .btn{min-height:52px;padding:0 10px}body{padding-bottom:76px}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.rv{opacity:1;transform:none}}
</style></head><body>
