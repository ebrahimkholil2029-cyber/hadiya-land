var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.15});$$('.rv').forEach(function(e,i){e.style.transitionDelay=(i%4)*80+'ms';io.observe(e)});
var gs=$$('.gs'),dt=$('.dots'),gi=0;gs.forEach(function(s,i){var b=document.createElement('button');b.setAttribute('aria-label','ছবি '+(i+1));b.onclick=function(){go(i)};dt.appendChild(b)});
function go(i){gi=i;gs.forEach(function(s,j){s.classList.toggle('on',j==i)});[].forEach.call(dt.children,function(b,j){b.classList.toggle('on',j==i)})}go(0);setInterval(function(){go((gi+1)%gs.length)},4000);
